# ---------------------------------------------------------------------------
# Clinic Management Application - server environment variables
# Copy to `.env` (never commit secrets) and adjust for your local database.
# ---------------------------------------------------------------------------

# PostgreSQL connection string:
#   Option A (Embedded zero-install): postgresql://postgres:postgres@localhost:55432/clinic_management?schema=public
#   Option B (Docker / Local Postgres): postgresql://postgres:postgres@localhost:5432/clinic_management?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/clinic_management?schema=public"

# Secret used to sign and verify JWT authentication tokens
JWT_SECRET="dev-only-secret-2f8c1a4d9b7e4306a5c2f1d8e7b6a394"

# Token validity lifetime (e.g., 8h, 1d)
JWT_EXPIRES_IN="8h"

# Application server listening port
PORT=3000
