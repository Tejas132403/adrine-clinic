# ---------------------------------------------------------------------------
# Clinic Management Application - environment variables
# Copy to `.env` (never commit the real file) and adjust for your machine.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
#   Option A (zero-install, used by `npm run db:up`): local embedded PostgreSQL.
#   Option B: docker compose up -d  ->  postgres://postgres:postgres@localhost:5432/clinic_management
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/clinic_management?schema=public"

# Secret used to sign JWTs. Generate one with: openssl rand -base64 32
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"

# Token lifetime for issued JWTs.
JWT_EXPIRES_IN="8h"

# HTTP port for the Next.js server (frontend + REST API).
PORT=3000
